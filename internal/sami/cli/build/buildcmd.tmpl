#!/usr/bin/env bash

# General setup
export EESSI_SITE_INSTALL=1
export EESSI_SITE_SOFTWARE_PREFIX={{ .CvmfsRepo }}

# hermetic target selection: build env must not inherit the login shell's view
unset EESSI_USER_INSTALL || true
unset EESSI_ACCELERATOR_TARGET_OVERRIDE EESSI_ACCELERATOR_TARGET EESSI_ACCEL_SUBDIR EESSI_ACCEL_SOFTWARE_SUBDIR_OVERRIDE

# Bugfixes
# need this to fix issue with failing downloads when using Easybuild
export SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt

{{- if .AccelSubdir }}
export EESSI_ACCELERATOR_TARGET_OVERRIDE={{ .AccelSubdir }}
export EESSI_ACCELERATOR_INSTALL=1

{{- end }}

source {{ .LmodInit }}

ml --force purge
ml load "EESSI/{{ .SWSVariant }}"

{{- if .AccelSubdir }}
# Guard against choking on EESSI's missing cuda modules
# TODO: make a stronger check here, it's possible someone forgets to pass cuda in the .Name
echo {{ .Name }} | grep -iq cuda
if [ "$?" -eq 0 ]; then
    module unuse $(echo "$MODULEPATH" | tr ':' '\n' | grep -E 'eessi\.io/.*accel')
fi

# Detect CUDA compute capability from the build node's GPU (X.Y, as EasyBuild expects).
# Env wins over cuda_cc in easyconfigs (cmakemake.py:387); unset means fail loudly, not wrong-arch.
if [ -z "${EASYBUILD_CUDA_COMPUTE_CAPABILITIES}" ]; then
    _cc=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -n 1)
    [ -n "${_cc}" ] && export EASYBUILD_CUDA_COMPUTE_CAPABILITIES="${_cc}"
    unset _cc
fi

{{- end }}

{{- $logdir := .Logdir }}
{{- range .Easystacks }}
ml load EESSI-extend
ml load {{ .EbVersion }}

echo "Building easystack: {{ .Path }}"
stack_file="{{ .Path }}"
if [ ! -f ${stack_file} ]; then
    printf "ERR - file not found ${stack_file}"
    exit 1
fi

eb --parallel="${EB_PARALLEL:-$(nproc)}" -r --easystack ${stack_file}
if [[ "$?" -ne 0 ]]; then
    printf "ERR - easybuild failed for ${stack_file}\n"
    # salvage the container /tmp (build dir, eb logs, shell command outputs) for post-mortem
    cp -a /tmp/ {{ $logdir }}/ctr-tmp
    exit 1
fi
{{- end }}

ARGS="-EESSI-version {{ .SWSVariant }} -name {{ .Name }} --arch-subdir {{ .ArchSubdir }} --outputDir {{ .OutputDir }}"
{{- if .AccelSubdir }}
ARGS="${ARGS} --accel-subdir {{ .AccelSubdir }}"
{{- end }}
{{- if .Owner }}
ARGS="${ARGS} --owner={{ .Owner }}"
{{- end }}
{{- if .Group }}
ARGS="${ARGS} --group={{ .Group }}"
{{- end }}

{{- if .Publish}}
    # creds provisioned by the sbatch wrapper via APPTAINERENV_ forwarding
    # (no creds file bind-mounted into the container)
    tb="$(crtar ${ARGS} | grep '^TARBALL=' | cut -d= -f2-)"
    bn="$(basename "$tb")"
    (cd "$(dirname "$tb")" && sha256sum "$bn" > "$bn.sha256")
{{- if .RGWEndpoint }}
    export AWS_ENDPOINT_URL={{ .RGWEndpoint }}
{{- end }}
    rgw object put {{ .RGWBucket }} "$bn" "$tb"
    # sentinel last: pullers only ingest pairs (default-deny)
    rgw object put {{ .RGWBucket }} "$bn.sha256" "$(dirname "$tb")/$bn.sha256"
{{- else }}
    crtar ${ARGS}
{{- end }}
